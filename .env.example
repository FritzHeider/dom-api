# ─────────────────────────────────────────────
#  ChatGPT DOM Agent Bridge — Environment Config
# ─────────────────────────────────────────────

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=change-me-in-production

# Browser Settings
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=./browser_profiles
CHATGPT_URL=https://chatgpt.com
BROWSER_TIMEOUT_MS=30000
BROWSER_SLOW_MO_MS=0

# Session Pool
SESSION_POOL_MIN=1
SESSION_POOL_MAX=5
SESSION_IDLE_TIMEOUT_S=300

# Redis Queue
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=chatgpt_bridge_queue
QUEUE_MAX_RETRY=3
QUEUE_PRIORITY_LEVELS=3

# Recovery
RECOVERY_MAX_RETRIES=3
RECOVERY_BACKOFF_BASE_S=2.0
RECOVERY_SESSION_RESTART_DELAY_S=5

# Monitoring
METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Timeouts (seconds)
PROMPT_SUBMIT_TIMEOUT_S=10
RESPONSE_WAIT_TIMEOUT_S=120
STREAM_IDLE_TIMEOUT_S=30
